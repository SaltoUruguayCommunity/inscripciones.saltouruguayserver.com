---
export const prerender = false;
---

<!DOCTYPE html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Conectando — Inscripciones Salto Uruguay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        background: #060109;
        color: #fff;
        font-family: 'Rubik', sans-serif;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        -webkit-font-smoothing: antialiased;
      }

      .bg-ambient {
        position: fixed;
        inset: 0;
        z-index: -10;
        background: #060109;
      }
      .bg-glow {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 600px;
        height: 600px;
        background: rgba(139, 92, 246, 0.08);
        filter: blur(150px);
        border-radius: 50%;
        pointer-events: none;
      }

      .card-wrapper {
        width: 100%;
        max-width: 420px;
        padding: 16px;
        animation: fade-in 0.5s ease-out;
      }
      .card {
        position: relative;
        background: rgba(10, 10, 15, 0.9);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 24px;
        padding: 40px 32px;
        overflow: hidden;
        box-shadow: 0 0 40px -10px rgba(0,0,0,0.7), inset 0 1px 1px rgba(255,255,255,0.06);
      }
      @media (max-width: 480px) {
        .card { padding: 32px 20px; border-radius: 20px; }
      }

      .loading-bar-track {
        position: absolute;
        top: 0;
        left: 0;
        height: 3px;
        width: 100%;
        background: rgba(255,255,255,0.03);
        overflow: hidden;
      }
      .loading-bar {
        height: 100%;
        background: linear-gradient(90deg, #7C3AED, #2563EB);
        animation: loading-bar 1.5s infinite linear;
      }
      @keyframes loading-bar {
        0% { width: 0%; transform: translateX(-100%); }
        50% { width: 50%; }
        100% { width: 100%; transform: translateX(100%); }
      }

      .conn-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 32px;
        padding: 0 8px;
      }
      .logo-wrap {
        position: relative;
      }
      .logo-glow {
        position: absolute;
        inset: -8px;
        border-radius: 50%;
        filter: blur(20px);
        opacity: 0.5;
      }
      .logo-img {
        position: relative;
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        border: 1px solid rgba(139, 92, 246, 0.25);
        background: rgba(139, 92, 246, 0.06);
        font-size: 28px;
      }

      .conn-dots {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
      }
      .conn-dots-row {
        display: flex;
        gap: 4px;
      }
      .conn-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #8B5CF6;
      }
      .conn-dot:nth-child(1) { animation: dot-pulse 1.4s ease-in-out 0s infinite; }
      .conn-dot:nth-child(2) { animation: dot-pulse 1.4s ease-in-out 0.2s infinite; }
      .conn-dot:nth-child(3) { animation: dot-pulse 1.4s ease-in-out 0.4s infinite; }
      @keyframes dot-pulse {
        0%, 100% { opacity: 0.2; }
        50% { opacity: 1; }
      }
      .conn-arrow {
        color: rgba(139, 92, 246, 0.4);
        width: 20px;
        height: 20px;
      }

      .title {
        font-size: 22px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
      }
      .subtitle {
        color: rgba(255,255,255,0.6);
        font-weight: 600;
        font-size: 14px;
      }
      .desc {
        color: rgba(255,255,255,0.35);
        font-size: 12px;
        line-height: 1.6;
        max-width: 280px;
        margin: 0 auto;
      }
      .footer-text {
        text-align: center;
        margin-top: 24px;
        font-size: 10px;
        font-family: monospace;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: rgba(255,255,255,0.12);
      }

      .spinner {
        width: 22px;
        height: 22px;
        border: 2.5px solid rgba(139,92,246,0.2);
        border-top-color: #8B5CF6;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
        display: inline-block;
      }
      @keyframes spin { to { transform: rotate(360deg); } }

      @keyframes fade-in {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
      }
    </style>
  </head>
  <body>
    <div class="bg-ambient">
      <div class="bg-glow"></div>
    </div>

    <div class="card-wrapper">
      <div class="card">
        <div class="loading-bar-track">
          <div class="loading-bar"></div>
        </div>

        <div class="conn-row">
          <div class="logo-wrap">
            <div class="logo-glow" style="background: rgba(139, 92, 246, 0.2);"></div>
            <div class="logo-img">
              <img src="/favicon.svg" alt="S" style="width:36px;height:36px;object-fit:contain;" />
            </div>
          </div>

          <div class="conn-dots">
            <div class="conn-dots-row">
              <div class="conn-dot"></div>
              <div class="conn-dot"></div>
              <div class="conn-dot"></div>
            </div>
            <svg class="conn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>

          <div class="logo-wrap">
            <div class="logo-glow" style="background: rgba(6, 182, 212, 0.15);"></div>
            <div class="logo-img" style="border-color: rgba(6, 182, 212, 0.25); background: rgba(6, 182, 212, 0.06);">
              <span style="font-size: 24px;">🎯</span>
            </div>
          </div>
        </div>

        <div style="text-align: center; display: flex; flex-direction: column; gap: 16px;">
          <h1 class="title">
            <span class="spinner"></span>
            Conectando...
          </h1>
          <div style="display: flex; flex-direction: column; gap: 6px;">
            <p class="subtitle">Solicitando acceso a SaltoUruguayServer</p>
            <p class="desc">Con tu cuenta podrás inscribirte a eventos y torneos de la comunidad.</p>
          </div>
        </div>
      </div>

      <p class="footer-text">Redireccionando de forma segura</p>
    </div>

    <script>
      import { signIn } from "auth-astro/client";

      setTimeout(() => {
        signIn("saltouruguay", { callbackUrl: "/auth/sus/callback" });
      }, 600);
    </script>
  </body>
</html>
