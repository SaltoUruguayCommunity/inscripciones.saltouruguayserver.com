---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import EventCard from '../components/EventCard.astro';
import { client } from '../db';
import { EventsTable, InscriptionsTable } from '../db/schema';
import { eq, sql } from 'drizzle-orm';

export const prerender = false;

const events = await client
  .select({
    id: EventsTable.id,
    title: EventsTable.title,
    description: EventsTable.description,
    coverImage: EventsTable.coverImage,
    eventDate: EventsTable.eventDate,
    eventLocation: EventsTable.eventLocation,
    status: EventsTable.status,
    maxParticipants: EventsTable.maxParticipants,
  })
  .from(EventsTable)
  .orderBy(EventsTable.eventDate)
  .all();

const eventsWithCounts = await Promise.all(
  events.map(async (event) => {
    const count = await client
      .select({ count: sql<number>`count(*)` })
      .from(InscriptionsTable)
      .where(eq(InscriptionsTable.eventId, event.id))
      .get();
    return { ...event, inscriptionCount: count?.count ?? 0 };
  })
);

const openEvents = eventsWithCounts.filter(e => e.status === 'open' || e.status === 'upcoming');
const otherEvents = eventsWithCounts.filter(e => e.status !== 'open' && e.status !== 'upcoming');
---

<Layout title="Incripciones — Salto Uruguay">
  <Hero />

  <!-- Events Section -->
  <section id="eventos" class="relative w-full max-w-7xl mx-auto px-4 sm:px-6 py-20">
    <!-- Ambient glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[300px] bg-purple-900/10 blur-[100px] rounded-full pointer-events-none"></div>

    <!-- Section Header (saltouruguay-web pattern) -->
    <div class="text-center mb-16 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-violet/10 border border-brand-violet/20 text-brand-violet-light text-xs font-bold uppercase tracking-widest mb-4">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        Próximos Eventos
      </div>
      <h2 class="font-[family-name:var(--font-anton)] text-4xl md:text-5xl text-white uppercase tracking-wide mb-4">
        Inscripciones <span class="text-transparent bg-clip-text bg-linear-to-r from-brand-violet-light to-brand-cyan">Abiertas</span>
      </h2>
      <p class="text-white/50 font-[family-name:var(--font-rubik)] text-lg max-w-2xl mx-auto">
        Elegí un evento y completá tu inscripción para participar
      </p>
    </div>

    {eventsWithCounts.length === 0 ? (
      <div class="glass-card-static p-16 text-center relative z-10">
        <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-white/5 border border-white/10 flex items-center justify-center">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-white/20">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        </div>
        <h3 class="font-[family-name:var(--font-anton)] text-xl text-white uppercase tracking-wide mb-2">No hay eventos todavía</h3>
        <p class="text-white/40 text-sm max-w-sm mx-auto font-[family-name:var(--font-rubik)]">
          Próximamente se publicarán eventos y torneos para inscribirte. Volvé a revisar pronto.
        </p>
      </div>
    ) : (
      <>
        {openEvents.length > 0 && (
          <div class="mb-20 relative z-10">
            <div class="flex items-center gap-2 mb-8">
              <span class="relative flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
              </span>
              <h3 class="font-[family-name:var(--font-teko)] text-2xl uppercase tracking-wider text-white/70">Inscripciones Abiertas</h3>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {openEvents.map((event, i) => (
                <div class="animate-fade-in-up" style={`animation-delay: ${i * 0.1}s`}>
                  <EventCard
                    title={event.title}
                    description={event.description ?? undefined}
                    coverImage={event.coverImage ?? undefined}
                    eventDate={event.eventDate ?? undefined}
                    eventLocation={event.eventLocation ?? undefined}
                    status={event.status}
                    maxParticipants={event.maxParticipants ?? undefined}
                    inscriptionCount={event.inscriptionCount}
                    href={`/eventos/${event.id}`}
                  />
                </div>
              ))}
            </div>
          </div>
        )}

        {otherEvents.length > 0 && (
          <div class="relative z-10">
            <div class="flex items-center gap-2 mb-8">
              <h3 class="font-[family-name:var(--font-teko)] text-2xl uppercase tracking-wider text-white/30">Otros Eventos</h3>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {otherEvents.map((event, i) => (
                <div class="animate-fade-in-up" style={`animation-delay: ${(openEvents.length + i) * 0.1}s`}>
                  <EventCard
                    title={event.title}
                    description={event.description ?? undefined}
                    coverImage={event.coverImage ?? undefined}
                    eventDate={event.eventDate ?? undefined}
                    eventLocation={event.eventLocation ?? undefined}
                    status={event.status}
                    maxParticipants={event.maxParticipants ?? undefined}
                    inscriptionCount={event.inscriptionCount}
                    href={`/eventos/${event.id}`}
                  />
                </div>
              ))}
            </div>
          </div>
        )}
      </>
    )}
  </section>
</Layout>
