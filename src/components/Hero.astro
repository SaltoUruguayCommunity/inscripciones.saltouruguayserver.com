---
---

<section id="hero" class="relative -mt-24 flex min-h-dvh w-full flex-col items-center justify-center overflow-hidden">
  <!-- Radial glow -->
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.04)_0%,transparent_60%)]"></div>

  <!-- Floating geometric shapes -->
  <div class="floating-shape absolute top-[20%] left-[10%] w-[200px] h-[200px] opacity-[0.03] animate-float-slow" style="border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%; border: 2px solid rgba(145, 70, 255, 0.5); animation-delay: 0s;"></div>
  <div class="floating-shape absolute top-[60%] right-[15%] w-[150px] h-[150px] opacity-[0.03] animate-float-slow rotate-45" style="border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%; border: 2px solid rgba(168, 85, 247, 0.5); animation-delay: -5s;"></div>
  <div class="floating-shape absolute bottom-[25%] left-[20%] w-[100px] h-[100px] opacity-[0.03] animate-float-slow rounded-full" style="border: 2px solid rgba(192, 132, 252, 0.5); animation-delay: -10s;"></div>

  <!-- Particles -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="particle animate-particle" style="width:5px;height:5px;left:10%;background:radial-gradient(circle,rgba(145,70,255,0.8) 0%,rgba(145,70,255,0) 70%);animation-duration:22s;animation-delay:0s;"></div>
    <div class="particle animate-particle" style="width:4px;height:4px;left:25%;background:radial-gradient(circle,rgba(59,130,246,0.7) 0%,rgba(59,130,246,0) 70%);animation-duration:20s;animation-delay:-3s;"></div>
    <div class="particle animate-particle" style="width:6px;height:6px;left:40%;background:radial-gradient(circle,rgba(145,70,255,0.6) 0%,rgba(145,70,255,0) 70%);animation-duration:25s;animation-delay:-6s;"></div>
    <div class="particle animate-particle" style="width:3px;height:3px;left:55%;background:radial-gradient(circle,rgba(6,182,212,0.7) 0%,rgba(6,182,212,0) 70%);animation-duration:18s;animation-delay:-2s;"></div>
    <div class="particle animate-particle" style="width:5px;height:5px;left:70%;background:radial-gradient(circle,rgba(145,70,255,0.5) 0%,rgba(145,70,255,0) 70%);animation-duration:24s;animation-delay:-8s;"></div>
    <div class="particle animate-particle" style="width:4px;height:4px;left:85%;background:radial-gradient(circle,rgba(59,130,246,0.6) 0%,rgba(59,130,246,0) 70%);animation-duration:21s;animation-delay:-4s;"></div>
    <div class="particle animate-particle" style="width:7px;height:7px;left:15%;background:radial-gradient(circle,rgba(145,70,255,0.4) 0%,rgba(145,70,255,0) 70%);animation-duration:26s;animation-delay:-11s;"></div>
    <div class="particle animate-particle" style="width:3px;height:3px;left:60%;background:radial-gradient(circle,rgba(6,182,212,0.5) 0%,rgba(6,182,212,0) 70%);animation-duration:19s;animation-delay:-7s;"></div>
    <div class="particle animate-particle" style="width:5px;height:5px;left:90%;background:radial-gradient(circle,rgba(145,70,255,0.7) 0%,rgba(145,70,255,0) 70%);animation-duration:23s;animation-delay:-1s;"></div>
    <div class="particle animate-particle" style="width:4px;height:4px;left:35%;background:radial-gradient(circle,rgba(59,130,246,0.4) 0%,rgba(59,130,246,0) 70%);animation-duration:27s;animation-delay:-9s;"></div>
    <div class="particle animate-particle" style="width:6px;height:6px;left:78%;background:radial-gradient(circle,rgba(145,70,255,0.3) 0%,rgba(145,70,255,0) 70%);animation-duration:20s;animation-delay:-5s;"></div>
    <div class="particle animate-particle" style="width:3px;height:3px;left:5%;background:radial-gradient(circle,rgba(6,182,212,0.6) 0%,rgba(6,182,212,0) 70%);animation-duration:22s;animation-delay:-12s;"></div>
    <div class="particle animate-particle" style="width:5px;height:5px;left:48%;background:radial-gradient(circle,rgba(145,70,255,0.5) 0%,rgba(145,70,255,0) 70%);animation-duration:25s;animation-delay:-3s;"></div>
    <div class="particle animate-particle" style="width:4px;height:4px;left:65%;background:radial-gradient(circle,rgba(59,130,246,0.5) 0%,rgba(59,130,246,0) 70%);animation-duration:18s;animation-delay:-8s;"></div>
    <div class="particle animate-particle" style="width:5px;height:5px;left:50%;background:radial-gradient(circle,rgba(145,70,255,0.6) 0%,rgba(145,70,255,0) 70%);animation-duration:24s;animation-delay:-6s;"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
    <!-- Logo with glow -->
    <div class="group relative animate-fade-in mb-8 inline-block">
      <div class="absolute -inset-6 rounded-full bg-white/5 opacity-0 blur-2xl transition-opacity duration-500 group-hover:opacity-100"></div>
      <img src="/favicon.svg" alt="Salto Uruguay" class="relative w-20 h-20 md:w-28 md:h-28 object-contain drop-shadow-[0_0_15px_rgba(255,255,255,0.05)] transition-all duration-500 ease-out group-hover:scale-105 group-hover:drop-shadow-[0_0_25px_rgba(255,255,255,0.15)]" />
    </div>

    <!-- Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-brand-violet-light text-xs font-bold uppercase tracking-widest mb-6 animate-fade-in-up">
      <span class="w-1.5 h-1.5 rounded-full bg-brand-emerald animate-pulse"></span>
      Abierto a inscripciones
    </div>

    <!-- Title -->
    <h1 class="font-[family-name:var(--font-anton)] text-5xl sm:text-6xl md:text-7xl text-white uppercase tracking-wide drop-shadow-[0_4px_24px_rgba(0,0,0,0.4)] mb-4 animate-fade-in-up-delay-1">
      Inscripciones
    </h1>

    <!-- Subtitle (metallic gradient) -->
    <h2 class="bg-linear-to-r from-white via-white/80 to-white/40 bg-clip-text font-[family-name:var(--font-teko)] text-2xl md:text-3xl uppercase tracking-[0.2em] text-transparent mb-6 animate-fade-in-up-delay-2">
      Eventos y Torneos
    </h2>

    <!-- Description -->
    <p class="text-white/50 font-[family-name:var(--font-rubik)] text-lg max-w-xl mx-auto leading-relaxed mb-10 animate-fade-in-up-delay-2">
      Participá de los mejores eventos organizados por la comunidad de
      <span class="text-white font-medium">Salto Uruguay Server</span>.
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-in-up-delay-3">
      <a href="#eventos" class="btn-primary">
        Ver Eventos
      </a>
      <a href="https://saltouruguayserver.com" target="_blank" class="btn-secondary">
        Conocer más
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 text-white/30 transition-all hover:-translate-y-1 hover:text-white/80 animate-bounce cursor-pointer">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5v14M19 12l-7 7-7-7"/>
    </svg>
  </div>
</section>
